{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "miyuki-writing-0.1 conversational example",
  "type": "object",
  "required": ["messages", "metadata"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1 }
        }
      },
      "description": "TRL SFT conversational messages: user (instruction+context) -> assistant (target prose). System optional."
    },
    "metadata": {
      "type": "object",
      "required": ["id", "instruction", "context", "category", "skills", "source", "notes", "word_count"],
      "properties": {
        "id": { "type": "string", "pattern": "^miyuki-0\\.1-\\d{3}$" },
        "instruction": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "category": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["scene","dialogue","character_voice","character_consistency","context_retention","emotion","action","description","pacing","subtext","rewriting","instruction_following","anti_meta","transitional","atmospheric","quiet","tension","humor","sensory_detail","continuity","continuation"] }
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "enum": ["human-authored","human-edited","synthetic"] },
        "notes": { "type": "string" },
        "word_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
